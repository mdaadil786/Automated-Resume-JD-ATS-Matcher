FLASK_ENV=development
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
STREAMLIT_PORT=8501

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# The supplied specification requires hybrid scoring but gives no numeric weights.
SEMANTIC_WEIGHT=0.50
LLM_WEIGHT=0.50

EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./storage/chroma
MAX_UPLOAD_MB=25
MAX_ZIP_FILES=100
MAX_TEXT_CHARS=30000
LOG_LEVEL=INFO
